# Copy to `.env` in the project root (gitignored) and replace the placeholders.
# docker compose and the application read these values.

# Required. Used as MySQL root password for the compose service and as the app password.
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/marketing?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave empty if Redis has no password.
REDIS_PASSWORD=

SERVER_PORT=9100

# Optional: public origin printed on short links when you are not on localhost.
# SHORTLINK_PUBLIC_BASE_URL=http://127.0.0.1:9100
# VITE_PUBLIC_SHORTLINK_ORIGIN=http://127.0.0.1:9100
