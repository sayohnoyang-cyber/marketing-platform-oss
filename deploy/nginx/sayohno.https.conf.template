# sayohno.cn HTTPS. Generated by deploy/nginx/render_config.py.
# http://sayohno.cn and http://www.sayohno.cn -> https://sayohno.cn
# http://<ip> keeps serving the site. https://www and https://<ip> redirect to the apex.

server {
    listen 80;
    server_name sayohno.cn www.sayohno.cn;

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://sayohno.cn$request_uri;
    }
}

server {
    listen 80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        root /var/www/certbot;
        try_files $uri =404;
    }

__SERVER_BODY__
}

server {
    listen 443 ssl http2;
    server_name www.sayohno.cn;

    ssl_certificate __CERT_FULLCHAIN__;
    ssl_certificate_key __CERT_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    return 301 https://sayohno.cn$request_uri;
}

server {
    listen 443 ssl http2 default_server;
    server_name _;

    ssl_certificate __CERT_FULLCHAIN__;
    ssl_certificate_key __CERT_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://sayohno.cn$request_uri;
}

