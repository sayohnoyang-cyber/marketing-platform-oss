# Copy this file to application-local.yaml (gitignored) and fill in local values.
# Do not commit real passwords.
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/marketing?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: ${MYSQL_USER:root}
    password: ${MYSQL_PASSWORD}
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password: ${REDIS_PASSWORD:}
